    <ProjectReference Include="..\Essentials.HashProviders.FNV1a_64\Essentials.HashProviders.FNV1a_64.csproj" />
    <ProjectReference Include="..\Essentials.HashProviders.MD5\Essentials.HashProviders.MD5.csproj" />
